{
	"name": "bonds-railway",
	"version": "1.0.0",
	"private": true,
	"description": "Railway infrastructure template for Bonds",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"plan": "railway config plan"
	},
	"dependencies": {
		"railway": "3.17.0"
	},
	"devDependencies": {
		"@tsconfig/node-ts": "23.6.5",
		"@tsconfig/node24": "24.0.6",
		"@tsconfig/strictest": "2.0.9",
		"@types/node": "26.6.6",
		"knip": "6.45.1",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "7.0.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.18.0"
}
