{
	"name": "bonds-railway",
	"version": "1.0.0",
	"private": true,
	"description": "Railway infrastructure template for Bonds",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"plan": "railway config plan"
	},
	"dependencies": {
		"railway": "3.11.0"
	},
	"devDependencies": {
		"@tsconfig/node-ts": "23.6.4",
		"@tsconfig/node24": "24.0.5",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.13.6",
		"knip": "6.36.0",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"oxlint-tsgolint": "7.0.2002",
		"typescript": "7.0.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.4.2"
}
